{
  "$schema": "../../level.schema.json",
  "id": "2.8",
  "chapter": 2,
  "number": 8,
  "title": "Boss: one messy day, three clean commits",
  "concept": "Stage selectively",
  "boss": true,
  "story": [
    {
      "speaker": "Sam",
      "text": "I worked on three things at once: added a map, updated the menu, and wrote a draft poster."
    },
    {
      "speaker": "Sam",
      "text": "Can you commit the map, then the menu separately, and ignore the draft poster completely?"
    },
    {
      "speaker": "Sam",
      "text": "No pressure!"
    }
  ],
  "workdir": "~/festival",
  "setup": {
    "steps": [
      {
        "run": "git init"
      },
      {
        "commit": {
          "message": "First commit",
          "files": {
            "index.html": "<h1>Festival</h1>\n",
            "menu.html": "Food\n"
          }
        }
      },
      {
        "files": {
          "map.html": "Map\n",
          "menu.html": "Food and Drinks\n",
          "poster.txt": "DRAFT\n"
        }
      }
    ]
  },
  "goal": {
    "items": [
      {
        "text": "Commit only the map",
        "checks": [
          {
            "type": "commitExists",
            "changesExactly": [
              "map.html"
            ]
          }
        ]
      },
      {
        "text": "Commit only the menu update",
        "checks": [
          {
            "type": "commitExists",
            "changesExactly": [
              "menu.html"
            ]
          }
        ]
      },
      {
        "text": "Ignore the poster and commit .gitignore",
        "checks": [
          {
            "type": "commitExists",
            "changesExactly": [
              ".gitignore"
            ]
          },
          {
            "type": "clean"
          }
        ]
      }
    ]
  },
  "hints": [
    "You have three changes. Each one deserves its own commit.",
    "Use `git add <file>` to stage one file at a time before each commit.",
    "Run `git add map.html`, `git commit -m \"map\"`, then repeat for menu.html. Use .gitignore for poster.txt."
  ],
  "par": 6,
  "allowedCommands": null,
  "recap": "You used the staging area to split your messy work into logical commits.",
  "cheatSheet": [],
  "predict": null,
  "solution": [
    {
      "run": "git add map.html"
    },
    {
      "run": "git commit -m \"map\""
    },
    {
      "run": "git add menu.html"
    },
    {
      "run": "git commit -m \"menu\""
    },
    {
      "edit": {
        "path": ".gitignore",
        "content": "poster.txt"
      }
    },
    {
      "run": "git add .gitignore"
    },
    {
      "run": "git commit -m \"ignore\""
    }
  ]
}
